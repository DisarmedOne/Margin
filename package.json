{
    "name": "margin",
    "productName": "Margin",
    "version": "1.6.0",
    "description": "Turn any paper into short, game-like study levels.",
    "main": "src/main/main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "test": "node --test src/main/",
        "icon": "electron build/make-icon.js",
        "dist": "electron-builder --win dir --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File build/make-installer.ps1"
    },
    "license": "UNLICENSED",
    "type": "commonjs",
    "dependencies": {
        "@anthropic-ai/sdk": "^1.14.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/source-serif-4": "^5.3.1",
        "electron-updater": "^6.8.11",
        "mammoth": "^1.13.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "electron": "^45.5.0",
        "electron-builder": "^26.18.0"
    },
    "build": {
        "appId": "app.margin.study",
        "productName": "Margin",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "src/**/*",
            "!src/**/*.test.js",
            "build/icon.png",
            "package.json"
        ],
        "win": {
            "target": "dir",
            "icon": "build/icon.png"
        },
        "publish": {
            "provider": "github",
            "owner": "DisarmedOne",
            "repo": "margin",
            "releaseType": "release"
        }
    }
}
